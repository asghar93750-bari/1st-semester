#include <iostream>
using namespace std;
int primenum(int n){
      if(n<2){
            cout<<"NOT PRIME";
            return 0;
      }
      else{
            for(int i=2; i<n; i++){
                  if(n%i==0){
                        cout<<"NOT PRIME";
                        return 0;
                  }
            }
            cout<<"NUMBER IS PRIME";
      }
      return 0;
}

int main(){
    int num{};
    cout<<"Enter a number that you want to find prime: ";
    cin>>num;
    cout<<"The result of your number that you input: "<<primenum(num)<<endl;
    return 0;
};
