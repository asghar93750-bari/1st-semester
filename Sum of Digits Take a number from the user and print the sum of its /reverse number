#include<iostream>
using namespace std;
int main() {
    int n{}, digit{}, reverse = 0;
    cout << "Enter a number: ";
    cin >> n;
    int length = 0;
    while (n != 0) {
        digit = n % 10;
        reverse = reverse * 10 + digit;
        length++;
        n /= 10;  // ✅ yeh line missing thi!
    }
    cout << reverse << endl;
    return 0;
}
